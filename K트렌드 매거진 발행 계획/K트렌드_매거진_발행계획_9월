<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>K트렌드 매거진 발행 계획 · 2026년 9월</title>
<link rel="preconnect" href="https://cdn.jsdelivr.net">
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/html-docx-js/dist/html-docx.js"></script>
<style>
  :root{
    --bg:#F7F6F1; --card:#FFFFFF; --line:#E6E4DC; --ink:#1E2532;
    --teal:#00B1BD; --violet:#6466FA; --muted:#6B7280; --soft:#9AA0AA;
    --tealsoft:#E6F7F8; --violetsoft:#EEEEFE; --amber:#B7791F; --ambersoft:#FBF3E2;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0; background:var(--bg); color:var(--ink);
    font-family:'Pretendard',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;
    line-height:1.62; font-size:15px; -webkit-font-smoothing:antialiased;}
  a{color:var(--teal); text-decoration:none;}

  .topbar{position:sticky; top:0; z-index:50; background:rgba(247,246,241,.86);
    backdrop-filter:blur(10px); border-bottom:1px solid var(--line);
    display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 24px;}
  .topbar__title{font-size:14.5px; font-weight:700; letter-spacing:-.01em;}
  .topbar__title span{color:var(--teal);}
  .topbar__btns{display:flex; gap:8px; flex-shrink:0;}
  .btn{border:1px solid var(--line); background:#fff; color:var(--ink); font-family:inherit;
    font-size:12.5px; font-weight:600; padding:7px 13px; border-radius:10px; cursor:pointer;
    transition:.15s; white-space:nowrap;}
  .btn:hover{border-color:var(--teal); color:var(--teal);}

  .wrap{max-width:1080px; margin:0 auto; padding:36px 24px 80px;}
  header.doc{margin:8px 0 30px;}
  .eyebrow{display:inline-block; font-size:12px; font-weight:700; letter-spacing:.04em;
    color:var(--teal); text-transform:uppercase; margin-bottom:12px;}
  h1{font-size:30px; font-weight:800; letter-spacing:-.02em; line-height:1.3; margin:0 0 16px;}
  .meta-row{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px;}
  .chip{font-size:12.5px; font-weight:600; padding:5px 11px; border-radius:20px;
    background:#fff; border:1px solid var(--line); color:var(--muted);}
  .chip--team{background:var(--violetsoft); border-color:transparent; color:var(--violet);}
  .chip--teal{background:var(--tealsoft); border-color:transparent; color:#009099;}
  .lead{background:#fff; border:1px solid var(--line); border-left:4px solid var(--teal);
    border-radius:14px; padding:18px 20px; font-size:14.5px; color:#374151;}
  .lead strong{color:var(--ink); font-weight:700;}

  section.card{background:var(--card); border:1px solid var(--line); border-radius:22px;
    padding:28px 30px; margin-top:26px;}
  h2{display:flex; align-items:center; gap:11px; font-size:19px; font-weight:800;
    letter-spacing:-.01em; margin:0 0 6px;}
  .num{display:inline-flex; align-items:center; justify-content:center; width:27px; height:27px;
    border-radius:9px; background:var(--teal); color:#fff; font-size:13.5px; font-weight:800; flex-shrink:0;}
  .sec-sub{font-size:13px; color:var(--muted); margin:0 0 18px; padding-left:38px;}

  /* ===== Process step buttons (도식) ===== */
  .steps{display:flex; flex-wrap:wrap; align-items:stretch; gap:8px;}
  .stepbtn{flex:1 1 140px; min-width:140px; display:flex; flex-direction:column; gap:5px;
    background:#fff; border:1px solid var(--line); border-radius:14px; padding:14px 15px;
    cursor:pointer; transition:.15s; position:relative;}
  .stepbtn:hover{border-color:var(--teal); transform:translateY(-2px);
    box-shadow:0 6px 18px rgba(0,177,189,.10);}
  .stepbtn__no{display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px;
    border-radius:7px; background:var(--tealsoft); color:#009099; font-size:12px; font-weight:800;}
  .stepbtn__t{font-size:13.5px; font-weight:700; color:var(--ink); letter-spacing:-.01em;}
  .stepbtn__d{font-size:11.5px; color:var(--soft); line-height:1.4;}
  .stepbtn__ext{position:absolute; top:12px; right:13px; font-size:11px; color:var(--soft);}
  .stepbtn--model{border-color:var(--violet); background:var(--violetsoft);}
  .stepbtn--model .stepbtn__no{background:#fff; color:var(--violet);}
  .arw{display:flex; align-items:center; color:var(--soft); font-weight:800; font-size:15px;}
  @media (max-width:720px){ .arw{display:none;} }

  /* ===== Model gallery ===== */
  .mgrid{display:grid; grid-template-columns:repeat(5,1fr); gap:12px;}
  .mcard{border:1px solid var(--line); border-radius:14px; overflow:hidden; background:#fff;
    display:flex; flex-direction:column; scroll-margin-top:80px;}
  .mcard img{width:100%; aspect-ratio:3/4; object-fit:cover; display:block; background:#eee;}
  .mcard__body{padding:11px 12px 13px;}
  .mcard__name{display:flex; align-items:center; gap:6px; font-size:15px; font-weight:800;}
  .mdot{width:9px; height:9px; border-radius:50%; display:inline-block;}
  .mcard__vibe{font-size:11.5px; color:var(--muted); margin-top:4px; line-height:1.45;}
  .mcard__dates{font-size:11px; color:var(--soft); margin-top:6px; font-weight:600;}
  .mcard__dl{display:inline-block; margin-top:9px; font-size:11.5px; font-weight:700;
    color:var(--teal); border:1px solid var(--line); border-radius:8px; padding:4px 9px;}
  .mcard__dl:hover{border-color:var(--teal);}
  .m-kim{background:#B8894B;} .m-seung{background:#00B1BD;} .m-min{background:#6466FA;}
  .m-mi{background:#E86A9A;} .m-hui{background:#3AA655;}
  @media (max-width:760px){ .mgrid{grid-template-columns:repeat(2,1fr);} }

  /* ===== Table ===== */
  .tbl-scroll{overflow-x:auto; -webkit-overflow-scrolling:touch; border-radius:12px;}
  table{width:100%; border-collapse:collapse; font-size:13px; min-width:760px;}
  thead th{background:var(--ink); color:#fff; font-weight:600; text-align:left;
    padding:10px 12px; white-space:nowrap; font-size:12.5px;}
  thead th:first-child{border-top-left-radius:10px;}
  thead th:last-child{border-top-right-radius:10px;}
  tbody td{padding:11px 12px; border-bottom:1px solid var(--line); vertical-align:top;}
  tbody tr:last-child td{border-bottom:none;}
  tbody tr:nth-child(even){background:#FBFAF7;}
  .date{font-weight:700; white-space:nowrap;}
  .kw{color:#374151;}
  .trend-tag{display:inline-block; font-size:11px; font-weight:700; padding:2px 8px;
    border-radius:6px; background:var(--tealsoft); color:#009099; margin-top:3px;}

  /* clickable search chip */
  a.q{display:inline-block; background:#F3F2EE; border:1px solid var(--line); border-radius:6px;
    padding:2px 8px; margin:1px 3px 1px 0; font-size:12px; color:#3B4252; white-space:nowrap;
    cursor:pointer; transition:.12s;}
  a.q:hover{background:#fff; border-color:var(--teal); color:#009099;}
  a.q::before{content:'🔍 '; font-size:10px; opacity:.7;}
  td.loc a.loc-v{color:var(--muted); display:block; margin-top:3px;}
  td.loc a.loc-v::before{content:'✨ ';}

  /* model chip in table */
  a.model{display:inline-flex; align-items:center; gap:5px; font-weight:700; font-size:13px;
    padding:3px 9px 3px 8px; border-radius:20px; border:1px solid var(--line); background:#fff;
    white-space:nowrap;}
  a.model::before{content:''; width:8px; height:8px; border-radius:50%;}
  a.model:hover{border-color:currentColor;}
  a.m-kim{color:#8a6224;} a.m-kim::before{background:#B8894B;}
  a.m-seung{color:#009099;} a.m-seung::before{background:#00B1BD;}
  a.m-min{color:#4b4de0;} a.m-min::before{background:#6466FA;}
  a.m-mi{color:#c94b7f;} a.m-mi::before{background:#E86A9A;}
  a.m-hui{color:#2b8546;} a.m-hui::before{background:#3AA655;}

  .skip-row td{background:var(--ambersoft) !important; color:var(--amber); font-weight:600; text-align:center;}

  ul.notes{list-style:none; padding:0; margin:0;}
  ul.notes li{position:relative; padding:10px 0 10px 30px; border-bottom:1px solid var(--line);
    font-size:14px; color:#374151;}
  ul.notes li:last-child{border-bottom:none;}
  ul.notes li::before{content:''; position:absolute; left:8px; top:17px; width:7px; height:7px;
    border-radius:50%; background:var(--teal);}
  ul.notes li strong{color:var(--ink); font-weight:700;}
  ul.notes li code{background:#F3F2EE; border:1px solid var(--line); border-radius:5px;
    padding:1px 6px; font-size:12px; color:#3B4252;}

  footer.doc{margin-top:34px; padding-top:20px; border-top:1px solid var(--line);
    font-size:12.5px; color:var(--soft); text-align:center;}

  /* trend learning routine */
  .num--loop{background:var(--violet);}
  .learn-src{display:flex; flex-direction:column; gap:5px; max-width:460px; position:relative;
    border:1px solid var(--violet); background:var(--violetsoft); border-radius:14px;
    padding:14px 15px; margin-bottom:20px; transition:.15s;}
  .learn-src:hover{transform:translateY(-2px); box-shadow:0 6px 18px rgba(100,102,250,.12);}
  .learn-src .stepbtn__no{background:#fff; color:var(--violet);}
  .learnflow{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:6px;}
  .lstep{flex:1 1 150px; min-width:150px; background:#fff; border:1px solid var(--line);
    border-radius:12px; padding:12px 13px;}
  .lstep__no{display:inline-flex; align-items:center; justify-content:center; width:20px; height:20px;
    border-radius:6px; background:var(--violetsoft); color:var(--violet); font-size:11px; font-weight:800; margin-bottom:6px;}
  .lstep__t{font-size:13px; font-weight:700; margin-bottom:3px;}
  .lstep__d{font-size:11.5px; color:var(--muted); line-height:1.45;}
  .status-pill{display:inline-block; font-size:11px; font-weight:700; padding:2px 9px; border-radius:20px; margin-right:6px;}
  .st-done{background:var(--tealsoft); color:#009099;}
  .st-todo{background:#F1F0EC; color:var(--muted);}

  @media print{
    .topbar{display:none;} body{background:#fff;}
    section.card{break-inside:avoid; border-color:#ddd;}
    .wrap{padding-top:16px;} .stepbtn{break-inside:avoid;}
  }
  @media (max-width:640px){
    .wrap{padding:24px 14px 60px;} h1{font-size:23px;}
    section.card{padding:20px 16px; border-radius:16px;}
    .topbar{padding:10px 14px;} .sec-sub{padding-left:0;}
  }
</style>
</head>
