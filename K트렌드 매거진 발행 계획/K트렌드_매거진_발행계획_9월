<script>
function pin(el){
  var qv = el.getAttribute('data-q') || el.textContent;
  window.open('https://kr.pinterest.com/search/pins/?q=' + encodeURIComponent(qv), '_blank', 'noopener');
}
function downloadDoc(){
  try{
    var header = '<!DOCTYPE html><html><head><meta charset="utf-8"></head><body>';
    var footer = '</body></html>';
    var source = header + document.getElementById('doc').innerHTML + footer;
    if(window.htmlDocx && window.htmlDocx.asBlob){
      triggerDownload(window.htmlDocx.asBlob(source), 'K트렌드_매거진_발행계획_9월.docx');
    } else {
      triggerDownload(new Blob(['\ufeff', source], {type:'application/msword'}), 'K트렌드_매거진_발행계획_9월.doc');
    }
  }catch(e){
    triggerDownload(new Blob(['\ufeff', document.getElementById('doc').innerHTML], {type:'application/msword'}), 'K트렌드_매거진_발행계획_9월.doc');
  }
}
function triggerDownload(blob, name){
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a'); a.href = url; a.download = name;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(function(){ URL.revokeObjectURL(url); }, 1500);
}
</script>
